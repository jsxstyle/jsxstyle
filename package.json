{
  "name": "jsxstyle-monorepo",
  "description": "The monorepo for jsxstyle and tools built for jsxstyle",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "version": "0.0.0",
  "homepage": "https://github.com/jsxstyle/jsxstyle#readme",
  "scripts": {
    "start": "pnpm --filter=minisite dev",
    "build": "pnpm clean:dist && tsc -b tsconfig.build.json --verbose",
    "lint": "oxlint",
    "lint:write": "oxlint --fix",
    "format": "oxfmt --check . && cd crates && cargo fmt --all -- --check",
    "format:write": "oxfmt . && cd crates && cargo fmt",
    "check": "oxlint && oxfmt --check . && cd crates && cargo fmt --all -- --check && cargo clippy --all-targets -- -D warnings",
    "check:write": "oxlint --fix && oxfmt . && cd crates && cargo fmt && cargo clippy --fix --allow-dirty --allow-staged --all-targets",
    "clean": "rm -rf node_modules && pnpm -r exec rm -rf node_modules",
    "clean:dist": "pnpm -r exec rm -rf lib dist build",
    "example": "tsx scripts/runExample.ts",
    "test": "pnpm build && vitest",
    "release": "changeset publish",
    "release:canary": "pnpm publish -r --access public --tag canary --no-git-checks",
    "version:canary": "rm -f ./.changeset/pre.json && changeset version --snapshot canary",
    "reset": "rm -rf packages/{*,*/*}/lib/ minisite/.next/",
    "update-readme": "echo \"$(<./misc/monorepo-preamble.md)\\n\\n---\\n\\n$(<./packages/jsxstyle/README.md)\" > README.md",
    "sync-configs": "tsx ./scripts/syncConfigs.ts",
    "build:rust": "cd crates && cargo build",
    "build:rust:release": "cd crates && cargo build --release",
    "build:napi": "cd crates/jsxstyle-swc-napi && napi build --platform --release --output-dir . --js-package-name @jsxstyle/bundler-utils",
    "build:napi:debug": "cd crates/jsxstyle-swc-napi && napi build --platform --output-dir . --js-package-name @jsxstyle/bundler-utils",
    "test:napi": "pnpm build:napi:debug && node crates/jsxstyle-swc-napi/smoke-test.cjs",
    "dev:rust": "cd crates && cargo watch -w .",
    "generate:rust-constants": "tsx scripts/generateRustConstants.ts"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "maintained node versions"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@changesets/types": "^6.1.0",
    "@jsxstyle/bundler-utils": "workspace:*",
    "@jsxstyle/core": "workspace:*",
    "@jsxstyle/internal": "workspace:*",
    "@napi-rs/cli": "^3.7.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@10.28.2"
}
