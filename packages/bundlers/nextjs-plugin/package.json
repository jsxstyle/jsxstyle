{
  "name": "@jsxstyle/nextjs-plugin",
  "version": "2.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsxstyle/jsxstyle",
    "directory": "packages/bundlers/nextjs-plugin"
  },
  "keywords": [
    "jsxstyle",
    "css-in-js",
    "nextjs",
    "plugin",
    "webpack",
    "turbopack"
  ],
  "files": [
    "lib",
    "!lib/tsconfig.tsbuildinfo"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./webpack-loader": {
      "types": "./lib/webpack-loader.d.ts",
      "import": "./lib/webpack-loader.js",
      "require": "./lib/webpack-loader.js"
    },
    "./turbopack-loader": {
      "types": "./lib/turbopack-loader.d.ts",
      "import": "./lib/turbopack-loader.js",
      "require": "./lib/turbopack-loader.js"
    }
  },
  "dependencies": {
    "@jsxstyle/bundler-utils": "workspace:*",
    "memfs": "^4.57.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "peerDependencies": {
    "next": ">=14.0.0"
  }
}
