{
  "name": "@jsxstyle/bundler-utils",
  "version": "1.0.3",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsxstyle/jsxstyle",
    "directory": "packages/bundlers/bundler-utils"
  },
  "keywords": [
    "jsxstyle",
    "css-in-js",
    "webpack",
    "rspack",
    "vite",
    "nextjs"
  ],
  "files": [
    "lib",
    "!lib/tsconfig.tsbuildinfo"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "dependencies": {
    "@jsxstyle/core": "workspace:*",
    "memfs": "^4.57.3",
    "tslib": "2.8.1"
  },
  "optionalDependencies": {
    "@jsxstyle/bundler-utils-darwin-arm64": "1.0.3",
    "@jsxstyle/bundler-utils-darwin-x64": "1.0.3",
    "@jsxstyle/bundler-utils-linux-arm64-gnu": "1.0.3",
    "@jsxstyle/bundler-utils-linux-x64-gnu": "1.0.3",
    "@jsxstyle/bundler-utils-linux-x64-musl": "1.0.3",
    "@jsxstyle/bundler-utils-win32-x64-msvc": "1.0.3"
  },
  "devDependencies": {
    "jsxstyle-swc-napi": "workspace:*",
    "webpack": "^5.107.2"
  }
}
