{
  "name": "@jsxstyle/webpack-plugin",
  "version": "4.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsxstyle/jsxstyle",
    "directory": "packages/bundlers/webpack-plugin"
  },
  "keywords": [
    "jsxstyle",
    "css-in-js",
    "plugin",
    "webpack"
  ],
  "files": [
    "lib",
    "!lib/tsconfig.tsbuildinfo"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./loader": {
      "types": "./lib/loader.d.ts",
      "import": "./lib/loader.js",
      "require": "./lib/loader.js"
    }
  },
  "dependencies": {
    "@jsxstyle/bundler-utils": "workspace:*",
    "memfs": "^4.57.3"
  },
  "devDependencies": {
    "@swc/core": "^1.15.40",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "css-loader": "^7.1.4",
    "mini-css-extract-plugin": "^2.10.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "swc-loader": "^0.2.7",
    "webpack": "^5.107.2"
  }
}
