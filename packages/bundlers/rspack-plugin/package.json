{
  "name": "@jsxstyle/rspack-plugin",
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsxstyle/jsxstyle",
    "directory": "packages/bundlers/rspack-plugin"
  },
  "keywords": [
    "jsxstyle",
    "css-in-js",
    "rspack",
    "rsbuild",
    "plugin"
  ],
  "files": [
    "lib",
    "!lib/tsconfig.tsbuildinfo"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./loader": {
      "types": "./lib/loader.d.ts",
      "import": "./lib/loader.js",
      "require": "./lib/loader.js"
    }
  },
  "dependencies": {
    "@jsxstyle/bundler-utils": "workspace:*"
  },
  "devDependencies": {
    "@rspack/core": "^2.0.5"
  },
  "peerDependencies": {
    "@rspack/core": ">=1.5.0 <2.0.0"
  }
}
